{
  "name": "kobi-stop-smoking-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "בוט טלגרם ללוויי גמילה מוויפ — מדבקות + מסטיק 2 מ\"ג + העבודה המנטלית",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv namespace create BOT_KV",
    "secret:token": "wrangler secret put BOT_TOKEN",
    "secret:hook": "wrangler secret put WEBHOOK_SECRET",
    "webhook:set": "node scripts/set-webhook.mjs set",
    "webhook:info": "node scripts/set-webhook.mjs info",
    "webhook:delete": "node scripts/set-webhook.mjs delete",
    "check": "python3 ../extraction/build_cbt_index.py --selftest && node scripts/check-refs.mjs && for f in src/*.js; do node --check \"$f\" || exit 1; done",
    "test": "npm run check --silent && node --test \"test/*.test.mjs\"",
    "test:live": "node scripts/live-check.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
